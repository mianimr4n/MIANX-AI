# ══════════════════════════════════════════════════════
# MIANX.AI — Environment Configuration
# Copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local to version control.
# ══════════════════════════════════════════════════════

# ── Database (required) ─────────────────────────────────
# LOCAL DEVELOPMENT (SQLite):
#   DATABASE_URL=file:./db/dev.db
#   Then: bun run db:push   (uses schema.dev.prisma)
#
# PRODUCTION (PostgreSQL):
#   DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public
#   Then: bun run db:migrate:deploy  (uses schema.prisma)
#
# For CI/build with no database, any valid PostgreSQL URL format works
# since prisma generate does not connect to the database.
DATABASE_URL=file:./db/dev.db

# ── Runtime ─────────────────────────────────────────────
# Node.js environment. Must be one of: development, production, test.
NODE_ENV=development

# ── App ─────────────────────────────────────────────────
# Public base URL of the application (used for CORS, redirects, etc.).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase Auth (required in production, optional in dev) ──
# Supabase project URL (e.g. https://your-project.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (server-side only — NEVER expose to clients).
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Providers (at least one recommended for AI features) ──
# OpenAI API key for GPT models.
OPENAI_API_KEY=

# Anthropic API key for Claude models.
ANTHROPIC_API_KEY=

# Google Generative AI API key for Gemini models.
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Production Settings ─────────────────────────────────
# Log level: DEBUG, INFO, WARN, ERROR. Defaults to INFO in production.
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins (e.g. https://app.example.com,https://admin.example.com).
ALLOWED_ORIGINS=

# ── Redis (optional — for distributed rate limiting) ─────
# Redis connection URL for distributed rate limiting.
# If not set, falls back to in-memory rate limiting (single-instance only).
# Example: redis://localhost:6379 or rediss://user:pass@host:6379/0
REDIS_URL=

# ── AI Safety Limits ────────────────────────────────────
# Maximum total tokens allowed per organization per day (min 1000, max 10000000).
AI_DAILY_TOKEN_LIMIT=100000

# Maximum number of AI requests allowed per organization per day (min 10, max 10000).
AI_DAILY_REQUEST_LIMIT=500
