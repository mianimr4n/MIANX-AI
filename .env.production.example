# MIANX.AI — Production Environment Template
# Copy to /opt/mianx-ai/.env.production on the production host.
# Fill every required secret with a real value. Never commit the real file.

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://app.mianx.ai

# PostgreSQL / Supabase
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/DATABASE?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=

# Platform administration
PLATFORM_ADMIN_EMAILS=
ALLOWED_ORIGINS=https://mianx.ai,https://app.mianx.ai
LOG_LEVEL=INFO
OBSERVABILITY_HEALTH_SECRET=

# AI providers — only configure providers actually used in production
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_DAILY_TOKEN_LIMIT=100000
AI_DAILY_REQUEST_LIMIT=500

# Stripe — required for paid subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Local PostgreSQL container values, if using docker-compose.production.yml
POSTGRES_USER=mianx
POSTGRES_PASSWORD=
POSTGRES_DB=mianx_ai
