// ══════════════════════════════════════════════════════════════════
// MIANX.AI — Core Database Schema v1.0
// Multi-Tenant, Multi-Domain, AI-Native Business Operating System
// ══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── ENUMS ──────────────────────────────────────────────────────

enum OrganizationStatus {
  active
  suspended
  trial
  archived
}

enum MembershipStatus {
  active
  suspended
  removed
  invited
}

enum ActorType {
  user
  agent
  system
}

// ── CORE TABLES ────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    OrganizationStatus @default(active)
  timezone  String   @default("UTC")
  locale    String   @default("en")
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     OrganizationMembership[]
  teams           Team[]
  roles           Role[]
  settings        Setting[]
  files           File[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  domains         OrganizationDomain[]
  modules         OrganizationModule[]
  conversations   Conversation[]
  agentConfigs    AgentConfig[]
  events          Event[]
  workflows       Workflow[]
  workflowRuns   WorkflowRun[]
  jobs           Job[]
  approvals      Approval[]
  apiKeys        ApiKey[]
  webhooks       Webhook[]
  webhookDeliveries WebhookDelivery[]
  oauthConnections OAuthConnection[]
  plans          Plan[]
  subscriptions  Subscription[]
  usageRecords   UsageRecord[]
  invoices       Invoice[]
  incidents      Incident[]
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  displayName String?
  avatarUrl  String?
  locale     String   @default("en")
  timezone   String   @default("UTC")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships OrganizationMembership[]
}

model OrganizationMembership {
  id             String             @id @default(cuid())
  organizationId String
  userId         String
  status         MembershipStatus   @default(invited)
  joinedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  profile       Profile         @relation(fields: [userId], references: [userId])
  roles         MembershipRole[]
  teamMembers   TeamMember[]

  @@unique([organizationId, userId])
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  members      TeamMember[]
}

model TeamMember {
  id             String @id @default(cuid())
  teamId         String
  membershipId   String
  createdAt      DateTime @default(now())

  team       Team                   @relation(fields: [teamId], references: [id])
  membership OrganizationMembership @relation(fields: [membershipId], references: [id])

  @@unique([teamId, membershipId])
}

model Role {
  id             String  @id @default(cuid())
  organizationId String?
  name           String
  slug           String
  description    String?
  isSystem       Boolean @default(false)

  organization Organization?  @relation(fields: [organizationId], references: [id])
  permissions   RolePermission[]
  memberships   MembershipRole[]

  @@unique([organizationId, slug])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model MembershipRole {
  membershipId String
  roleId       String

  membership OrganizationMembership @relation(fields: [membershipId], references: [id])
  role       Role                   @relation(fields: [roleId], references: [id])

  @@unique([membershipId, roleId])
}

model Setting {
  id             String @id @default(cuid())
  organizationId String
  scopeType      String
  scopeId        String?
  key            String
  value          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, scopeType, scopeId, key])
}

model File {
  id             String   @id @default(cuid())
  organizationId String
  uploadedBy     String
  name           String
  storagePath    String
  mimeType       String?
  size           Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

model AuditLog {
  id            String    @id @default(cuid())
  organizationId String
  actorType     ActorType
  actorId       String
  action        String
  resourceType  String
  resourceId    String?
  metadata      String?
  createdAt     DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Notification {
  id              String    @id @default(cuid())
  organizationId String
  recipientUserId String
  type            String
  title           String
  body            String?
  data            String?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

// ── DOMAIN ENGINE TABLES ───────────────────────────────────────

enum DomainStatus {
  draft
  available
  deprecated
  archived
}

enum ModuleStatus {
  draft
  available
  disabled
  deprecated
}

model Domain {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  version     String
  description String?
  status      DomainStatus @default(draft)
  manifest    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organizationDomains OrganizationDomain[]
  modules             Module[]
}

model OrganizationDomain {
  id             String       @id @default(cuid())
  organizationId String
  domainId       String
  status         String       @default("active")
  configuration  String?
  activatedAt    DateTime?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  domain       Domain       @relation(fields: [domainId], references: [id])

  @@unique([organizationId, domainId])
}

model Module {
  id          String       @id @default(cuid())
  domainId    String
  name        String
  slug        String
  version     String
  description String?
  status      ModuleStatus @default(draft)
  manifest    String?

  domain Domain @relation(fields: [domainId], references: [id])
  orgModules OrganizationModule[]

  @@unique([domainId, slug])
}

model OrganizationModule {
  id             String   @id @default(cuid())
  organizationId String
  moduleId       String
  status         String   @default("active")
  configuration  String?
  activatedAt    DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  module       Module       @relation(fields: [moduleId], references: [id])

  @@unique([organizationId, moduleId])
}

// ── AI CORE TABLES ─────────────────────────────────────────────

enum MessageRole {
  system
  user
  assistant
  tool
}

enum ConversationStatus {
  active
  archived
  deleted
}

model Conversation {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  title          String?
  agentSlug      String?
  status         ConversationStatus @default(active)
  metadata       String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  messages     AiMessage[]

  @@index([organizationId, userId])
}

model AiMessage {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  toolCalls      String?
  toolResults    String?
  model          String?
  provider       String?
  tokensIn       Int          @default(0)
  tokensOut      Int          @default(0)
  latencyMs      Int          @default(0)
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AgentConfig {
  id             String   @id @default(cuid())
  organizationId String
  slug           String
  name           String
  description    String?
  systemPrompt   String
  model          String
  provider       String
  temperature    Float    @default(0.7)
  maxTokens      Int      @default(4096)
  tools          String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, slug])
}

// ── AUTOMATION TABLES ─────────────────────────────────────────

enum EventStatus {
  pending
  delivered
  failed
  dead_lettered
}

enum WorkflowStatus {
  draft
  active
  disabled
  archived
}

enum RunStatus {
  queued
  running
  waiting
  waiting_approval
  completed
  failed
  cancelled
  timed_out
  dead_lettered
}

enum StepStatus {
  pending
  running
  completed
  failed
  skipped
  cancelled
}

enum JobStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum JobPriority {
  low
  normal
  high
  critical
}

enum ApprovalDecision {
  pending
  approved
  rejected
  expired
}

model Event {
  id              String     @id @default(cuid())
  eventType       String
  eventVersion    String     @default("1")
  organizationId  String
  domainId        String?
  sourceType      String     @default("system")
  sourceId        String?
  actorType       String     @default("system")
  actorId         String?
  correlationId   String?
  causationId     String?
  payload         String
  metadata        String?
  status          EventStatus @default(pending)
  deliveredAt     DateTime?
  createdAt       DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  triggeredRuns WorkflowRun[]

  @@index([organizationId, status, createdAt])
  @@index([eventType, status])
}

model Workflow {
  id              String         @id @default(cuid())
  organizationId  String
  name            String
  slug            String
  description     String?
  triggerType     String         @default("event")
  triggerConfig   String
  steps           String
  conditions      String?
  retryPolicy     String?
  timeoutSeconds  Int            @default(300)
  status          WorkflowStatus @default(draft)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  runs           WorkflowRun[]

  @@unique([organizationId, slug])
}

model WorkflowRun {
  id              String     @id @default(cuid())
  workflowId      String
  organizationId  String
  triggerEventId  String?
  status          RunStatus  @default(queued)
  input           String?
  output          String?
  currentStep     Int?
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workflow    Workflow       @relation(fields: [workflowId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  triggerEvent Event?        @relation(fields: [triggerEventId], references: [id])
  stepRuns    WorkflowStepRun[]
  approvals    Approval[]

  @@index([workflowId, status])
  @@index([organizationId, status])
}

model WorkflowStepRun {
  id              String     @id @default(cuid())
  workflowRunId  String
  stepId         String
  status          StepStatus @default(pending)
  attempt         Int        @default(1)
  input           String?
  output          String?
  error           String?
  idempotencyKey String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
  @@unique([workflowRunId, stepId, idempotencyKey])
}

model Job {
  id              String       @id @default(cuid())
  organizationId  String
  type            String
  payload         String?
  status          JobStatus   @default(pending)
  priority        JobPriority  @default(normal)
  scheduledAt     DateTime?
  attempts        Int          @default(0)
  maxAttempts     Int          @default(3)
  lastError       String?
  runAt           DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status, priority, scheduledAt])
}

model Approval {
  id                String           @id @default(cuid())
  workflowRunId     String
  workflowStepRunId String?
  organizationId      String
  requestedAction    String
  requestedBy        String?
  approvedBy         String?
  decision          ApprovalDecision  @default(pending)
  reason            String?
  expiresAt         DateTime?
  decidedAt         DateTime?
  createdAt          DateTime         @default(now())

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id])
  organization  Organization  @relation(fields: [organizationId], references: [id])

  @@index([decision, createdAt])
}

// ── INTEGRATION TABLES ─────────────────────────────────────────

enum ApiKeyStatus {
  active
  revoked
  expired
}

enum WebhookStatus {
  active
  disabled
}

enum WebhookDeliveryStatus {
  pending
  success
  failed
  retrying
}

enum OAuthProvider {
  google
  github
  stripe
  custom
}

enum OAuthConnectionStatus {
  active
  expired
  revoked
  error
}

model ApiKey {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  prefix          String
  keyHash         String
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  status          ApiKeyStatus @default(active)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  webhooks    Webhook[]

  @@index([organizationId, status])
  @@unique([organizationId, prefix])
}

model Webhook {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  url             String
  secret          String
  eventTypes      String
  apiKeyId        String?
  status          WebhookStatus @default(active)
  lastDeliveryAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id])
  apiKey       ApiKey?        @relation(fields: [apiKeyId], references: [id])
  deliveries    WebhookDelivery[]

  @@index([organizationId, status])
}

model WebhookDelivery {
  id              String                @id @default(cuid())
  webhookId       String
  organizationId  String
  eventId         String?
  eventType       String
  payload         String
  statusCode      Int?
  response        String?
  status          WebhookDeliveryStatus @default(pending)
  attempt         Int                   @default(1)
  deliveredAt      DateTime?
  createdAt       DateTime              @default(now())

  webhook      Webhook      @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  organization  Organization  @relation(fields: [organizationId], references: [id])

  @@index([webhookId, status])
  @@index([organizationId, createdAt])
}

model OAuthConnection {
  id                String                @id @default(cuid())
  organizationId    String
  provider          OAuthProvider
  externalAccountId String?
  externalAccountName String?
  accessToken       String
  refreshToken      String?
  tokenExpiresAt    DateTime?
  metadata          String?
  status            OAuthConnectionStatus @default(active)
  lastUsedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
  @@index([organizationId, status])
}

// ── BILLING & ENTITLEMENT TABLES ──────────────────────────────

enum PlanBillingCycle {
  monthly
  yearly
  one_time
}

enum PlanStatus {
  draft
  active
  archived
  deprecated
}

enum SubscriptionState {
  trialing
  active
  past_due
  grace_period
  paused
  cancelled
  expired
  suspended
}

enum EntitlementStatus {
  enabled
  disabled
  limited
  trial
  expired
  suspended
}

enum OverageBehavior {
  hard_limit
  soft_limit
  auto_overage
  prepaid_credits
}

enum UsageMeterType {
  counter
  gauge
  unique
}

enum InvoiceStatus {
  draft
  issued
  paid
  failed
  voided
}

enum InvoiceLineType {
  base_plan
  domain
  module
  seats
  usage
  ai_usage
  add_on
  credit
  discount
  tax
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
  partially_refunded
}

model Plan {
  id            String           @id @default(cuid())
  name          String
  slug          String
  description   String?
  billingCycle  PlanBillingCycle @default(monthly)
  basePrice     Float            @default(0)
  currency      String           @default("USD")
  status        PlanStatus       @default(draft)
  isSystem      Boolean          @default(false)
  metadata      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  organization    Organization?   @relation(fields: [organizationId], references: [id])
  organizationId  String?
  versions        PlanVersion[]
  subscriptions    Subscription[]

  @@unique([organizationId, slug])
  @@index([status])
}

model PlanVersion {
  id            String   @id @default(cuid())
  planId        String
  version       Int
  name          String?
  description   String?
  features      String
  limits        String?
  seatAllowance Int      @default(1)
  aiTokenAllowance Int  @default(0)
  status        String   @default("active")
  createdAt     DateTime @default(now())

  plan             Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions    Subscription[]

  @@unique([planId, version])
}

model Feature {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  category    String?
  metadata    String?
  createdAt   DateTime @default(now())
}

model Subscription {
  id               String            @id @default(cuid())
  organizationId   String
  planId           String?
  planVersionId    String
  state            SubscriptionState @default(trialing)
  trialEndsAt      DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  seatCount        Int               @default(1)
  canceledAt       DateTime?
  expiresAt        DateTime?
  pausedAt         DateTime?
  metadata         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  plan         Plan?        @relation(fields: [planId], references: [id])
  planVersion  PlanVersion  @relation(fields: [planVersionId], references: [id])
  invoices     Invoice[]

  @@unique([organizationId])
  @@index([state])
  @@index([currentPeriodEnd])
}

model UsageMeter {
  id               String           @id @default(cuid())
  key              String           @unique
  name             String
  description      String?
  unit             String           @default("count")
  meterType        UsageMeterType   @default(counter)
  aggregation       String           @default("sum")
  resetCycle       String           @default("monthly")
  overageBehavior  OverageBehavior  @default(hard_limit)
  defaultLimit     Int?
  metadata         String?
  createdAt        DateTime         @default(now())
}

model UsageRecord {
  id              String   @id @default(cuid())
  organizationId  String
  meterKey        String
  quantity        Float
  unit            String   @default("count")
  source          String?
  idempotencyKey  String   @unique
  metadata        String?
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, meterKey, occurredAt])
  @@index([idempotencyKey])
}

model Invoice {
  id               String        @id @default(cuid())
  organizationId   String
  subscriptionId   String
  invoiceNumber    String
  status           InvoiceStatus @default(draft)
  periodStart      DateTime
  periodEnd        DateTime
  currency         String        @default("USD")
  subtotal         Float         @default(0)
  discount         Float         @default(0)
  tax              Float         @default(0)
  total            Float         @default(0)
  lineItems        String
  issuedAt         DateTime?
  dueAt            DateTime?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@unique([organizationId, invoiceNumber])
  @@index([subscriptionId])
  @@index([status])
}

// ── OBSERVABILITY TABLES ─────────────────────────────────────

enum IncidentSeverity {
  P1
  P2
  P3
  P4
}

enum IncidentState {
  detected
  acknowledged
  investigating
  mitigating
  monitoring
  resolved
}

model Incident {
  id              String           @id @default(cuid())
  title           String
  severity        IncidentSeverity @default(P3)
  status          IncidentState    @default(detected)
  service         String
  owner           String
  impact          String           @default("")
  organizationId  String?
  detectedAt      DateTime         @default(now())
  startedAt       DateTime?
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  commander       String?
  technicalLead   String?
  commsOwner      String?
  sme             String?
  timeline        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization    Organization?    @relation(fields: [organizationId], references: [id])

  @@index([status, severity])
  @@index([organizationId])
}

enum AlertSeverity {
  P1
  P2
  P3
  P4
}

enum AlertState {
  firing
  acknowledged
  resolved
  silenced
}

model AlertRecord {
  id              String         @id @default(cuid())
  severity        AlertSeverity  @default(P3)
  status          AlertState     @default(firing)
  owner           String
  name            String
  description     String
  what            String
  why             String
  who             String
  action          String
  fingerprint     String
  firedAt         DateTime       @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  silencedUntil   DateTime?
  organizationId  String?
  labels          String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, severity])
  @@index([fingerprint])
}

model SLOTarget {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String
  target        Float    // e.g. 0.999 = 99.9%
  windowDays    Int      @default(30)
  metricName    String
  labels        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  periods       SLOPeriod[]
}

model SLOPeriod {
  id                    String   @id @default(cuid())
  sloTargetId           String
  periodStart           DateTime @default(now())
  periodEnd             DateTime
  totalEvents           Int      @default(0)
  goodEvents            Int      @default(0)
  badEvents             Int      @default(0)
  availability          Float    @default(1)
  errorBudgetTotal      Float    @default(0)
  errorBudgetConsumed   Float    @default(0)
  errorBudgetRemaining  Float    @default(0)
  errorBudgetPct        Float    @default(100)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  sloTarget SLOTarget @relation(fields: [sloTargetId], references: [id], onDelete: Cascade)

  @@index([sloTargetId, periodStart])
}
