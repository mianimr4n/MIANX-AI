// ══════════════════════════════════════════════════════════════════
// MIANX.AI — Core Database Schema v1.0
// Multi-Tenant, Multi-Domain, AI-Native Business Operating System
// ══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── ENUMS ──────────────────────────────────────────────────────

enum OrganizationStatus {
  active
  suspended
  trial
  archived
}

enum MembershipStatus {
  active
  suspended
  removed
  invited
}

enum ActorType {
  user
  agent
  system
}

// ── CORE TABLES ────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    OrganizationStatus @default(active)
  timezone  String   @default("UTC")
  locale    String   @default("en")
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     OrganizationMembership[]
  teams           Team[]
  roles           Role[]
  settings        Setting[]
  files           File[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  domains         OrganizationDomain[]
  modules         OrganizationModule[]
  conversations   Conversation[]
  agentConfigs    AgentConfig[]
  events          Event[]
  workflows       Workflow[]
  workflowRuns   WorkflowRun[]
  jobs           Job[]
  approvals      Approval[]
  apiKeys        ApiKey[]
  webhooks       Webhook[]
  webhookDeliveries WebhookDelivery[]
  oauthConnections OAuthConnection[]
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  displayName String?
  avatarUrl  String?
  locale     String   @default("en")
  timezone   String   @default("UTC")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships OrganizationMembership[]
}

model OrganizationMembership {
  id             String             @id @default(cuid())
  organizationId String
  userId         String
  status         MembershipStatus   @default(invited)
  joinedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  profile       Profile         @relation(fields: [userId], references: [userId])
  roles         MembershipRole[]
  teamMembers   TeamMember[]

  @@unique([organizationId, userId])
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  members      TeamMember[]
}

model TeamMember {
  id             String @id @default(cuid())
  teamId         String
  membershipId   String
  createdAt      DateTime @default(now())

  team       Team                   @relation(fields: [teamId], references: [id])
  membership OrganizationMembership @relation(fields: [membershipId], references: [id])

  @@unique([teamId, membershipId])
}

model Role {
  id             String  @id @default(cuid())
  organizationId String?
  name           String
  slug           String
  description    String?
  isSystem       Boolean @default(false)

  organization Organization?  @relation(fields: [organizationId], references: [id])
  permissions   RolePermission[]
  memberships   MembershipRole[]

  @@unique([organizationId, slug])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model MembershipRole {
  membershipId String
  roleId       String

  membership OrganizationMembership @relation(fields: [membershipId], references: [id])
  role       Role                   @relation(fields: [roleId], references: [id])

  @@unique([membershipId, roleId])
}

model Setting {
  id             String @id @default(cuid())
  organizationId String
  scopeType      String
  scopeId        String?
  key            String
  value          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, scopeType, scopeId, key])
}

model File {
  id             String   @id @default(cuid())
  organizationId String
  uploadedBy     String
  name           String
  storagePath    String
  mimeType       String?
  size           Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

model AuditLog {
  id            String    @id @default(cuid())
  organizationId String
  actorType     ActorType
  actorId       String
  action        String
  resourceType  String
  resourceId    String?
  metadata      String?
  createdAt     DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Notification {
  id              String    @id @default(cuid())
  organizationId String
  recipientUserId String
  type            String
  title           String
  body            String?
  data            String?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

// ── DOMAIN ENGINE TABLES ───────────────────────────────────────

enum DomainStatus {
  draft
  available
  deprecated
  archived
}

enum ModuleStatus {
  draft
  available
  disabled
  deprecated
}

model Domain {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  version     String
  description String?
  status      DomainStatus @default(draft)
  manifest    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organizationDomains OrganizationDomain[]
  modules             Module[]
}

model OrganizationDomain {
  id             String       @id @default(cuid())
  organizationId String
  domainId       String
  status         String       @default("active")
  configuration  String?
  activatedAt    DateTime?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  domain       Domain       @relation(fields: [domainId], references: [id])

  @@unique([organizationId, domainId])
}

model Module {
  id          String       @id @default(cuid())
  domainId    String
  name        String
  slug        String
  version     String
  description String?
  status      ModuleStatus @default(draft)
  manifest    String?

  domain Domain @relation(fields: [domainId], references: [id])
  orgModules OrganizationModule[]

  @@unique([domainId, slug])
}

model OrganizationModule {
  id             String   @id @default(cuid())
  organizationId String
  moduleId       String
  status         String   @default("active")
  configuration  String?
  activatedAt    DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  module       Module       @relation(fields: [moduleId], references: [id])

  @@unique([organizationId, moduleId])
}

// ── AI CORE TABLES ─────────────────────────────────────────────

enum MessageRole {
  system
  user
  assistant
  tool
}

enum ConversationStatus {
  active
  archived
  deleted
}

model Conversation {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  title          String?
  agentSlug      String?
  status         ConversationStatus @default(active)
  metadata       String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  messages     AiMessage[]

  @@index([organizationId, userId])
}

model AiMessage {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  toolCalls      String?
  toolResults    String?
  model          String?
  provider       String?
  tokensIn       Int          @default(0)
  tokensOut      Int          @default(0)
  latencyMs      Int          @default(0)
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AgentConfig {
  id             String   @id @default(cuid())
  organizationId String
  slug           String
  name           String
  description    String?
  systemPrompt   String
  model          String
  provider       String
  temperature    Float    @default(0.7)
  maxTokens      Int      @default(4096)
  tools          String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, slug])
}

// ── AUTOMATION TABLES ─────────────────────────────────────────

enum EventStatus {
  pending
  delivered
  failed
  dead_lettered
}

enum WorkflowStatus {
  draft
  active
  disabled
  archived
}

enum RunStatus {
  queued
  running
  waiting
  waiting_approval
  completed
  failed
  cancelled
  timed_out
  dead_lettered
}

enum StepStatus {
  pending
  running
  completed
  failed
  skipped
  cancelled
}

enum JobStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum JobPriority {
  low
  normal
  high
  critical
}

enum ApprovalDecision {
  pending
  approved
  rejected
  expired
}

model Event {
  id              String     @id @default(cuid())
  eventType       String
  eventVersion    String     @default("1")
  organizationId  String
  domainId        String?
  sourceType      String     @default("system")
  sourceId        String?
  actorType       String     @default("system")
  actorId         String?
  correlationId   String?
  causationId     String?
  payload         String
  metadata        String?
  status          EventStatus @default(pending)
  deliveredAt     DateTime?
  createdAt       DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  triggeredRuns WorkflowRun[]

  @@index([organizationId, status, createdAt])
  @@index([eventType, status])
}

model Workflow {
  id              String         @id @default(cuid())
  organizationId  String
  name            String
  slug            String
  description     String?
  triggerType     String         @default("event")
  triggerConfig   String
  steps           String
  conditions      String?
  retryPolicy     String?
  timeoutSeconds  Int            @default(300)
  status          WorkflowStatus @default(draft)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  runs           WorkflowRun[]

  @@unique([organizationId, slug])
}

model WorkflowRun {
  id              String     @id @default(cuid())
  workflowId      String
  organizationId  String
  triggerEventId  String?
  status          RunStatus  @default(queued)
  input           String?
  output          String?
  currentStep     Int?
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workflow    Workflow       @relation(fields: [workflowId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  triggerEvent Event?        @relation(fields: [triggerEventId], references: [id])
  stepRuns    WorkflowStepRun[]
  approvals    Approval[]

  @@index([workflowId, status])
  @@index([organizationId, status])
}

model WorkflowStepRun {
  id              String     @id @default(cuid())
  workflowRunId  String
  stepId         String
  status          StepStatus @default(pending)
  attempt         Int        @default(1)
  input           String?
  output          String?
  error           String?
  idempotencyKey String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
  @@unique([workflowRunId, stepId, idempotencyKey])
}

model Job {
  id              String       @id @default(cuid())
  organizationId  String
  type            String
  payload         String?
  status          JobStatus   @default(pending)
  priority        JobPriority  @default(normal)
  scheduledAt     DateTime?
  attempts        Int          @default(0)
  maxAttempts     Int          @default(3)
  lastError       String?
  runAt           DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status, priority, scheduledAt])
}

model Approval {
  id                String           @id @default(cuid())
  workflowRunId     String
  workflowStepRunId String?
  organizationId      String
  requestedAction    String
  requestedBy        String?
  approvedBy         String?
  decision          ApprovalDecision  @default(pending)
  reason            String?
  expiresAt         DateTime?
  decidedAt         DateTime?
  createdAt          DateTime         @default(now())

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id])
  organization  Organization  @relation(fields: [organizationId], references: [id])

  @@index([decision, createdAt])
}

// ── INTEGRATION TABLES ─────────────────────────────────────────

enum ApiKeyStatus {
  active
  revoked
  expired
}

enum WebhookStatus {
  active
  disabled
}

enum WebhookDeliveryStatus {
  pending
  success
  failed
  retrying
}

enum OAuthProvider {
  google
  github
  stripe
  custom
}

enum OAuthConnectionStatus {
  active
  expired
  revoked
  error
}

model ApiKey {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  prefix          String
  keyHash         String
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  status          ApiKeyStatus @default(active)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  webhooks    Webhook[]

  @@index([organizationId, status])
  @@unique([organizationId, prefix])
}

model Webhook {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  url             String
  secret          String
  eventTypes      String
  apiKeyId        String?
  status          WebhookStatus @default(active)
  lastDeliveryAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id])
  apiKey       ApiKey?        @relation(fields: [apiKeyId], references: [id])
  deliveries    WebhookDelivery[]

  @@index([organizationId, status])
}

model WebhookDelivery {
  id              String                @id @default(cuid())
  webhookId       String
  organizationId  String
  eventId         String?
  eventType       String
  payload         String
  statusCode      Int?
  response        String?
  status          WebhookDeliveryStatus @default(pending)
  attempt         Int                   @default(1)
  deliveredAt      DateTime?
  createdAt       DateTime              @default(now())

  webhook      Webhook      @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  organization  Organization  @relation(fields: [organizationId], references: [id])

  @@index([webhookId, status])
  @@index([organizationId, createdAt])
}

model OAuthConnection {
  id                String                @id @default(cuid())
  organizationId    String
  provider          OAuthProvider
  externalAccountId String?
  externalAccountName String?
  accessToken       String
  refreshToken      String?
  tokenExpiresAt    DateTime?
  metadata          String?
  status            OAuthConnectionStatus @default(active)
  lastUsedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
  @@index([organizationId, status])
}
